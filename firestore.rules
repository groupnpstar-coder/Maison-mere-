rules_version = '2';
// Maison Mère — règles de sécurité (version 03.11-a)
// 1. Seul le client peut valider (payer) une étape.
// 2. Chacun ne voit que ses chantiers ; les numéros de téléphone sont privés.
// 3. Un prix accepté ne peut plus être changé en cachette.
// 4. Photos, messages, commandes, offres : seulement les personnes concernées.
// 5. Un avis = un vrai chantier ou une vraie commande ensemble ; on ne peut pas effacer un avis.
// 6. Le compte admin doit avoir un email confirmé.
// En cas de problème : copier le contenu de firestore-ancien.rules dans la console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed()  { return request.auth != null; }
    function uid()     { return request.auth.uid; }
    function isAdmin() { return signed() && request.auth.token.email == 'groupnpstar@gmail.com' && request.auth.token.email_verified == true; }
    function me()      { return get(/databases/$(database)/documents/profiles/$(uid())).data; }
    function myProId() { return me().get('proId', null); }
    function amExpert(){ return me().get('expertOk', false) == true; }
    function myWKey()  { return get(/databases/$(database)/documents/private/$(uid())).data.get('wkey', ''); }
    function now()     { return request.time.toMillis(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function prj(id)   { return get(/databases/$(database)/documents/projects/$(id)).data; }
    function ord(id)   { return get(/databases/$(database)/documents/orders/$(id)).data; }

    // la personne fait-elle partie de ce chantier ?
    function seeProject(id) {
      let d = prj(id);
      return isAdmin() || d.clientUid == uid()
        || (myProId() != null && (d.get('proId', null) == myProId() || d.get('guardProId', null) == myProId() || d.get('openVisit', false) == true))
        || uid() in d.get('inspectorUids', []) || uid() in d.get('expertUids', [])
        || (d.get('needExpert', false) == true && amExpert())
        || (myWKey() != '' && myWKey() in d.get('watchKeys', []));
    }

    // un avis ajouté à la fin de la liste, signé, et lié à un vrai chantier / une vraie commande
    function lastReview() { return request.resource.data.reviews[request.resource.data.reviews.size() - 1]; }
    function oneMoreReview() {
      return changed().hasOnly(['reviews'])
        && request.resource.data.reviews.size() == resource.data.get('reviews', []).size() + 1
        && request.resource.data.reviews[0:resource.data.get('reviews', []).size()] == resource.data.get('reviews', [])
        && lastReview().uid == uid();
    }
    // avis du client sur un pro
    function reviewOfPro(proId) {
      let t = lastReview().tx.split(':');
      return oneMoreReview() && (
        (t[0] in ['step', 'prj'] && prj(t[1]).clientUid == uid() && prj(t[1]).proId == proId)
        || (t[0] == 'g' && prj(t[1]).clientUid == uid() && prj(t[1]).guardHistory[int(t[2])].proId == proId)
        || (t[0] == 'ord' && ord(t[1]).clientUid == uid() && ord(t[1]).sellerProId == proId));
    }
    // avis d'un pro sur un client
    function reviewOfClient(u) {
      let t = lastReview().tx.split(':');
      return oneMoreReview() && (
        (t[0] in ['step', 'prj'] && myProId() != null && prj(t[1]).clientUid == u && prj(t[1]).proId == myProId())
        || (t[0] == 'g' && myProId() != null && prj(t[1]).clientUid == u && prj(t[1]).guardHistory[int(t[2])].proId == myProId())
        || (t[0] == 'ord' && ord(t[1]).clientUid == u
            && (ord(t[1]).get('sellerUid', null) == uid() || (myProId() != null && ord(t[1]).get('sellerProId', null) == myProId()))));
    }

    // ---------- PROFILS (sans numéro de téléphone) ----------
    match /profiles/{u} {
      allow read: if signed();
      allow create: if signed() && u == uid()
        && !('phone' in request.resource.data)
        && request.resource.data.get('expertOk', false) == false
        && request.resource.data.get('proId', null) == null;
      allow update: if isAdmin()
        || (signed() && u == uid()
            && !changed().hasAny(['reviews'])
            && (!changed().hasAny(['phone']) || !('phone' in request.resource.data))
            && (!changed().hasAny(['expertOk']) || request.resource.data.expertOk == false)
            && (!changed().hasAny(['expert']) || request.resource.data.expert.status == 'demande')
            && (!changed().hasAny(['proId']) || request.resource.data.proId == null
                || get(/databases/$(database)/documents/pros/$(request.resource.data.proId)).data.ownerUid == uid()))
        // un pro peut seulement AJOUTER un avis sur un client avec qui il a travaillé
        || (signed() && reviewOfClient(u));
      allow delete: if isAdmin();
    }

    // ---------- PARTIE PRIVÉE (téléphone) ----------
    match /private/{u} {
      allow read, write: if isAdmin() || (signed() && u == uid());
    }

    // ---------- FICHES DES PROS ----------
    match /pros/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.ownerUid == uid()
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('idVerified', false) == false
        && request.resource.data.get('caution', 0) == 0;
      allow update: if isAdmin()
        || (signed() && resource.data.ownerUid == uid()
            && !changed().hasAny(['ownerUid','verified','verifiedAt','idVerified','idVerifiedAt','caution','idUnlocked','hidden','stats','reviews']))
        || (signed() && changed().hasOnly(['stats']))
        || (signed() && reviewOfPro(id));
      allow delete: if isAdmin();
    }

    // ---------- CHANTIERS ----------
    match /projects/{pid} {

      function isClient(x)  { return x.clientUid == uid(); }
      function isPro(x)     { return myProId() != null && x.proId == myProId(); }

      // --- une étape (ancienne a, nouvelle b) ---
      function statusOk(a, b, cl, pr, ex, ps) {
        return (a.status == 'attente' && b.status == 'bloque' && cl && ps == 'ok')
          || (a.status == 'bloque' && b.status == 'fait' && pr && b.doneAt > now() - 21600000 && b.doneAt < now() + 21600000)
          || (a.status in ['bloque', 'fait'] && b.status == 'paye' && cl)
          || (a.status == 'fait' && b.status == 'paye' && b.get('auto', false) == true && now() - a.doneAt > 604800000)
          || (a.status in ['bloque', 'fait'] && b.status == 'litige' && cl)
          || (a.status in ['bloque', 'fait'] && b.status == 'rembourse' && (cl || pr))
          || (a.status == 'litige' && b.status in ['paye', 'rembourse', 'bloque'] && ex && b.dispute.expertUid == uid());
      }
      function stepOk(a, b, cl, pr, ex, ps, hasPro) {
        let ch = b.diff(a).affectedKeys();
        return (!ch.hasAny(['amount', 'mat', 'tr', 'matMode', 'wall'])
                  || (a.status == 'attente' && b.status == 'attente'
                      && ((pr && ps == 'attente_client') || (cl && ps == (hasPro ? 'attente_pro' : 'ok')))))
          && (!ch.hasAny(['status']) || statusOk(a, b, cl, pr, ex, ps))
          && (!ch.hasAny(['doneAt']) || (ch.hasAny(['status']) && b.status == 'fait'))
          && (!ch.hasAny(['code']) || (cl && a.status == 'attente' && b.status == 'bloque'))
          && (!ch.hasAny(['invoice']) || pr)
          // l'argent du matériel ne part que sur décision du client (ou de l'admin)
          && (!ch.hasAny(['matPaid', 'matPaidAt']) || cl)
          && (!ch.hasAny(['dispute']) || cl || ex);
      }
      function stepAt(o, n, i, cl, pr, ex, ps, hasPro) {
        return (i >= o.size() && i >= n.size())
          || (i < o.size() && i < n.size() && (o[i] == n[i] || stepOk(o[i], n[i], cl, pr, ex, ps, hasPro)))
          || (i >= o.size() && i < n.size() && cl && n[i].status == 'attente')
          || (i < o.size() && i >= n.size() && cl && o[i].status in ['attente', 'paye', 'rembourse']);
      }
      function stepsOk(cl, pr, ex) {
        let o = resource.data.get('steps', []);
        let n = request.resource.data.get('steps', []);
        let ps = request.resource.data.get('pricesStatus', 'ok');
        let hp = request.resource.data.get('proId', null) != null;
        return !changed().hasAny(['steps']) || (n.size() <= 15
          && stepAt(o, n, 0, cl, pr, ex, ps, hp) && stepAt(o, n, 1, cl, pr, ex, ps, hp) && stepAt(o, n, 2, cl, pr, ex, ps, hp)
          && stepAt(o, n, 3, cl, pr, ex, ps, hp) && stepAt(o, n, 4, cl, pr, ex, ps, hp) && stepAt(o, n, 5, cl, pr, ex, ps, hp)
          && stepAt(o, n, 6, cl, pr, ex, ps, hp) && stepAt(o, n, 7, cl, pr, ex, ps, hp) && stepAt(o, n, 8, cl, pr, ex, ps, hp)
          && stepAt(o, n, 9, cl, pr, ex, ps, hp) && stepAt(o, n, 10, cl, pr, ex, ps, hp) && stepAt(o, n, 11, cl, pr, ex, ps, hp)
          && stepAt(o, n, 12, cl, pr, ex, ps, hp) && stepAt(o, n, 13, cl, pr, ex, ps, hp) && stepAt(o, n, 14, cl, pr, ex, ps, hp));
      }
      // "prix d'accord" : seule la personne qui attend la réponse peut accepter
      function pricesOk(cl, pr) {
        let o = resource.data.get('pricesStatus', 'ok');
        let n = request.resource.data.get('pricesStatus', 'ok');
        let hp = request.resource.data.get('proId', null) != null;
        return !changed().hasAny(['pricesStatus'])
          || (pr && (n == 'attente_client' || (n == 'ok' && o == 'attente_pro')))
          || (cl && (n == 'attente_pro' || (n == 'ok' && (o == 'attente_client' || !hp))));
      }
      function newStepsAttente(n) {
        return n.size() <= 15
          && (n.size() <= 0 || n[0].status == 'attente') && (n.size() <= 1 || n[1].status == 'attente')
          && (n.size() <= 2 || n[2].status == 'attente') && (n.size() <= 3 || n[3].status == 'attente')
          && (n.size() <= 4 || n[4].status == 'attente') && (n.size() <= 5 || n[5].status == 'attente')
          && (n.size() <= 6 || n[6].status == 'attente') && (n.size() <= 7 || n[7].status == 'attente')
          && (n.size() <= 8 || n[8].status == 'attente') && (n.size() <= 9 || n[9].status == 'attente')
          && (n.size() <= 10 || n[10].status == 'attente') && (n.size() <= 11 || n[11].status == 'attente')
          && (n.size() <= 12 || n[12].status == 'attente') && (n.size() <= 13 || n[13].status == 'attente')
          && (n.size() <= 14 || n[14].status == 'attente');
      }

      // LIRE : seulement les gens du chantier
      allow read: if isAdmin()
        || (signed() && resource.data.clientUid == uid())
        || (signed() && myProId() != null && resource.data.proId == myProId())
        || (signed() && myProId() != null && resource.data.guardProId == myProId())
        || (signed() && uid() in resource.data.inspectorUids)
        || (signed() && uid() in resource.data.expertUids)
        || (signed() && resource.data.openVisit == true && myProId() != null)
        || (signed() && resource.data.needExpert == true && amExpert())
        || (signed() && myWKey() != '' && myWKey() in resource.data.watchKeys);

      allow create: if signed() && request.resource.data.clientUid == uid()
        && newStepsAttente(request.resource.data.get('steps', []));

      function canSee(d) {
        return d.clientUid == uid()
          || (myProId() != null && (d.get('proId', null) == myProId() || d.get('guardProId', null) == myProId()))
          || uid() in d.get('inspectorUids', []) || uid() in d.get('expertUids', [])
          || (myWKey() != '' && myWKey() in d.get('watchKeys', []));
      }
      function updOk() {
        let d = resource.data;
        let cl = isClient(d);
        let pr = isPro(d);
        let ex = amExpert() && uid() in request.resource.data.get('expertUids', []);
        let visitor = (myProId() != null && d.get('openVisit', false) == true) || uid() in d.get('inspectorUids', []);
        return !changed().hasAny(['clientUid', 'createdAt'])
          && (cl || !changed().hasAny(['proId', 'proName', 'watchers', 'watchKeys', 'autoVisits', 'reviewed', 'clientPhone', 'guard', 'guardProId']))
          && (pr || !changed().hasAny(['site', 'proReviewed']))
          && (cl || pr
              || (visitor && changed().hasOnly(['visits', 'inspectorUids', 'openVisit', 'msgN', 'lastMsgAt', 'lastMsgBy']))
              || (ex && changed().hasOnly(['steps', 'needExpert', 'expertUids', 'msgN', 'lastMsgAt', 'lastMsgBy']))
              || (changed().hasOnly(['msgN', 'lastMsgAt', 'lastMsgBy']) && canSee(d)))
          && pricesOk(cl, pr)
          && stepsOk(cl, pr, ex);
      }
      allow update: if isAdmin() || (signed() && updOk());
      allow delete: if isAdmin();
    }

    // ---------- MESSAGES ET PHOTOS DU CHANTIER ----------
    match /messages/{pid} {
      allow read, write: if signed() && seeProject(pid);
    }
    match /photos/{id} {
      allow read: if signed() && seeProject(resource.data.projectId);
      allow create: if signed() && request.resource.data.uid == uid() && seeProject(request.resource.data.projectId);
      allow update, delete: if isAdmin();
    }
    match /checkins/{id} {
      allow read: if signed() && seeProject(resource.data.projectId);
      allow create: if signed() && request.resource.data.uid == uid() && seeProject(request.resource.data.projectId);
      allow update, delete: if isAdmin();
    }

    // ---------- DEMANDES DE TRAVAUX (visibles par les pros) ----------
    match /requests/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.clientUid == uid();
      allow update: if isAdmin()
        || (signed() && resource.data.clientUid == uid() && !changed().hasAny(['clientUid']))
        || (signed() && myProId() != null && changed().hasOnly(['offerCount'])
            && request.resource.data.offerCount == resource.data.get('offerCount', 0) + 1);
      allow delete: if isAdmin();
    }

    // ---------- OFFRES DE PRIX : le client et le pro concerné ----------
    match /offers/{id} {
      allow read: if isAdmin()
        || (signed() && resource.data.clientUid == uid())
        || (signed() && myProId() != null && resource.data.proId == myProId());
      allow create: if signed() && request.resource.data.proUid == uid()
        && myProId() != null && request.resource.data.proId == myProId()
        && request.resource.data.status == 'envoyee';
      allow update: if isAdmin()
        || (signed() && resource.data.clientUid == uid() && changed().hasOnly(['status', 'projectId', 'msgN', 'lastMsgAt', 'lastMsgBy']))
        || (signed() && myProId() != null && resource.data.proId == myProId() && changed().hasOnly(['msgN', 'lastMsgAt', 'lastMsgBy']));
      allow delete: if isAdmin();
    }
    match /offerchats/{oid} {
      allow read, write: if isAdmin() || (signed() && (
        get(/databases/$(database)/documents/offers/$(oid)).data.clientUid == uid()
        || get(/databases/$(database)/documents/offers/$(oid)).data.proUid == uid()
        || (myProId() != null && get(/databases/$(database)/documents/offers/$(oid)).data.proId == myProId())));
    }

    // ---------- COMMANDES EN QUINCAILLERIE : l'acheteur et le vendeur ----------
    match /orders/{id} {
      function isBuyer()  { return resource.data.clientUid == uid(); }
      function isSeller() { return resource.data.get('sellerUid', null) == uid()
                                   || (myProId() != null && resource.data.get('sellerProId', null) == myProId()); }
      function st0() { return resource.data.status; }
      function st1() { return request.resource.data.status; }
      allow read: if isAdmin()
        || (signed() && resource.data.clientUid == uid())
        || (signed() && resource.data.sellerUid == uid())
        || (signed() && myProId() != null && resource.data.sellerProId == myProId());
      allow create: if signed() && request.resource.data.clientUid == uid() && request.resource.data.status == 'bloque';
      allow update: if isAdmin() || (signed()
        && !changed().hasAny(['clientUid', 'sellerUid', 'sellerProId', 'storeId', 'productId', 'price', 'qty', 'fee', 'total', 'cur'])
        && (
          // l'acheteur : payer ou ouvrir un litige
          (isBuyer() && changed().hasOnly(['status', 'paidAt', 'disputeAt', 'rvClient', 'msgN', 'lastMsgAt', 'lastMsgBy'])
            && (!changed().hasAny(['status']) || (st0() in ['bloque', 'livre'] && st1() in ['paye', 'litige'])))
          // le vendeur : dire « livré » avec une photo
          || (isSeller() && changed().hasOnly(['status', 'deliveredAt', 'photo', 'rvSeller', 'msgN', 'lastMsgAt', 'lastMsgBy'])
            && (!changed().hasAny(['status']) || (st0() == 'bloque' && st1() == 'livre'
                && request.resource.data.deliveredAt > now() - 21600000 && request.resource.data.deliveredAt < now() + 21600000)))
          // paiement automatique 7 jours après la livraison sans réponse
          || ((isBuyer() || isSeller()) && changed().hasOnly(['status', 'paidAt', 'auto'])
            && st0() == 'livre' && st1() == 'paye' && now() - resource.data.deliveredAt > 604800000)
        ));
      allow delete: if isAdmin();
    }

    // ---------- RÉGLAGES DE L'APP ----------
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- LE RESTE (inchangé pour l'instant : à revoir par le développeur) ----------
    match /{col}/{doc} {
      allow read, write: if signed() && !(col in ['profiles', 'private', 'pros', 'projects', 'config', 'messages', 'photos', 'checkins', 'requests', 'offers', 'offerchats', 'orders']);
    }
  }
}
